# Gateway
PORT=8402
UPSTREAM_CATALOG=https://store.shangdian.me/api/catalog
STORE_NAME=Silas Store
STORE_URL=https://store.shangdian.me
PAY_TO=0xDEMO000000000000000000000000000000000402
X402_NETWORK=bsc
X402_ASSET=USDT
